# ══════════════════════════════════════════════════════════════
# LUFIT OS — Variáveis de Ambiente
# Preencha e renomeie este arquivo para .env
# ══════════════════════════════════════════════════════════════

# ── App Base ──
APP_URL=https://sua-url-de-producao.com

# ── Kimi OAuth (já preenchido pelo init.sh) ──
APP_ID=seu-app-id
APP_SECRET=seu-app-secret
VITE_APP_ID=seu-app-id
VITE_KIMI_AUTH_URL=https://auth.kimi.com
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=seu-union-id

# ── Database ──
DATABASE_URL=mysql://user:pass@host:port/db?ssl={"rejectUnauthorized":true}

# ── Mercado Pago (OBRIGATÓRIO para dinheiro cair na conta) ──
# Salmo: gere o token em https://www.mercadopago.com.br/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=TEST-00000000-0000-0000-0000-000000000000

# ── Kangu (OBRIGATÓRIO para frete real) ──
# Salmo: solicite token em https://www.kangu.com.br/
KANGU_API_TOKEN=seu-token-kangu

# ── Uploads (S3 opcional) ──
S3_ENDPOINT=https://s3.seu-endpoint.com
S3_BUCKET=lufit-uploads
S3_ACCESS_KEY=sua-access-key
S3_SECRET_KEY=sua-secret-key
S3_REGION=ap-southeast-1
